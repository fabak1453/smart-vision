<?xml version="1.0" encoding="utf-8"?>
<!--
  Smart Vision ERP — Android network policy.

  The shop PC runs the ERP server over plain HTTP on the local Wi-Fi
  (e.g. http://192.168.1.10:51732). Android 9+ blocks cleartext HTTP by
  default, which silently breaks CSV download/upload and LAN sync from the
  phone / tablet. Cleartext is permitted here so the APK can reach the shop PC.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
