{
  "name": "smart-vision-erp",
  "productName": "Smart Vision ERP",
  "version": "9.8.1",
  "private": true,
  "description": "Smart Vision Enterprise — CCTV ERP (Windows desktop, SQLite)",
  "main": "electron/main.js",
  "author": "Smart Vision Enterprise",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/verify.js",
    "verify": "node scripts/verify.js",
    "apk:sync": "npm run prepare-app && npm --prefix apk run sync",
    "dist": "node scripts/dist-win.js",
    "dist:win": "npm run dist"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/standalone": "^7.26.4",
    "@zxing/library": "0.23.0",
    "better-sqlite3": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.smartvision.erp",
    "productName": "Smart Vision ERP",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "electron/**",
      "app/**",
      "build/icon.png",
      "package.json",
      "!keygen/**",
      "!apk/**",
      "!android/**",
      "!capacitor.config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Vision ERP",
      "artifactName": "Smart Vision ERP Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "Smart Vision ERP ${version} Portable.exe"
    }
  }
}
